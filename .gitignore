# ---------------------------------------------------------------------------
# 构建产物与本地状态
# ---------------------------------------------------------------------------
*.pro.user
*.pro.user.*
.qmake.stash
Makefile
Makefile.*
build-*/
*-build/
# 上面两条覆盖 build-xxx/ 与 xxx-build/（含 _test-build/），
# 但覆盖不到 _build-xxx/（前缀下划线 + 中间连字符），因此单列一条。
/_build-*/
debug/
release/
.qmake.cache

# 编译中间产物
*.o
*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.a
*.so
*.so.*
*.dylib
moc_*.cpp
qrc_*.cpp
ui_*.h
*.moc

# ---------------------------------------------------------------------------
# 交付目录（编译后可执行文件与运行库）
#
# 交付目录刻意不纳入跟踪：任何 checkout 都不应该把用户手上的可执行文件打回旧构建。
# 参考 Ailecium docs/PRD-actions.md #338 的取证结论。
# ---------------------------------------------------------------------------
/LqCompare/
/dist/
/package/

# ---------------------------------------------------------------------------
# 本地设置与运行时状态
# ---------------------------------------------------------------------------
/config/
*.lqc.user
*.log
LqCompare.log*
*.bak
*.orig

# 本目录是工作区级的助手状态（无人值守任务的历史记录、工作日志），
# 每个人机器上都不一样，因此与 /config/ 同类：属于本地状态，不进版本库。
# 它**不是**缓存，不要删除（丢掉的是「上一轮做到哪了」这份上下文）。
/.workbuddy/

# Qt 翻译编译产物由 .ts 生成
*.qm

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.idea/
.vscode/
.cache/
compile_commands.json
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp

# ---------------------------------------------------------------------------
# 并行开发留下的脚手架与临时构建目录
#
# 2026-09-20 夜间的 24 个工作流各自在自己的一次性目录里构建与跑探针
# （.codex-work/、.build-*/、build/、Tests/<套件>/build*/），这些都不是交付物。
# 之前只有 `build-*/` 与 `*-build/` 两条，漏掉了点号前缀与单个词 build，
# 于是 `git add -A` 会把这些目录连同里面的 .o 与截图一起收进版本库。
# ---------------------------------------------------------------------------
.codex-work/
.build-*/
build/

# ---------------------------------------------------------------------------
# Tests/OptionsDialog 的 saveReviewScreenshots() 会把对话框截图写进「当前工作目录」
# （跑测试时的 cwd 是仓库根），于是每跑一次全量测试就多出三个未跟踪的 png。
# 它们是给人看的复核产物，不是交付物；留在工作区里会让后续每一轮接手时
# 都把它们误判成「上一轮留下的用户文件」（这一条已经误判过两次）。
# ---------------------------------------------------------------------------
/options-*.png
