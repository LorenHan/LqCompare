# ---------------------------------------------------------------------------
# 构建产物与本地状态
# ---------------------------------------------------------------------------
*.pro.user
*.pro.user.*
.qmake.stash
Makefile
Makefile.*
build-*/
*-build/
# 上面两条覆盖 build-xxx/ 与 xxx-build/（含 _test-build/），
# 但覆盖不到 _build-xxx/（前缀下划线 + 中间连字符），因此单列一条。
/_build-*/
debug/
release/
.qmake.cache

# 编译中间产物
*.o
*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.a
*.so
*.so.*
*.dylib
moc_*.cpp
qrc_*.cpp
ui_*.h
*.moc

# ---------------------------------------------------------------------------
# 交付目录（编译后可执行文件与运行库）
#
# 交付目录刻意不纳入跟踪：任何 checkout 都不应该把用户手上的可执行文件打回旧构建。
# 参考 Ailecium docs/PRD-actions.md #338 的取证结论。
# ---------------------------------------------------------------------------
/LqCompare/
/dist/
/package/

# ---------------------------------------------------------------------------
# 本地设置与运行时状态
# ---------------------------------------------------------------------------
/config/
*.lqc.user
*.log
LqCompare.log*
*.bak
*.orig

# Qt 翻译编译产物由 .ts 生成
*.qm

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.idea/
.vscode/
.cache/
compile_commands.json
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
